{
  "name": "soren-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/export.mjs",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "test": "node --import tsx --test tests/core.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check:rpc": "node scripts/check-rpc.mjs",
    "check:pool": "node --import tsx scripts/check-pool.mjs",
    "build:share": "node scripts/share.mjs",
    "test:keyboard": "node tests/keyboard.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
